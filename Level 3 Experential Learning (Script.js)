// Clock Functionality
function updateClock() {
    const clockElement = document.getElementById('clock');
    if (clockElement) {
        const now = new Date();
        const options = { 
            weekday: 'long', 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric', 
            hour: '2-digit', 
            minute: '2-digit',
            second: '2-digit'
        };
        clockElement.textContent = now.toLocaleDateString('en-US', options);
    }
}

// Update clock every second
setInterval(updateClock, 1000);
updateClock();

// Weather API Configuration (OpenWeatherMap - free tier)
const API_KEY = 'YOUR_API_KEY_HERE'; // Replace with your OpenWeatherMap API key
const API_URL = 'https://api.openweathermap.org/data/2.5/';

// Current Weather State
let currentTempC = 36;
let currentTempF = 96.8;
let isCelsius = true;
let currentCity = 'Hyderabad';

// Dark Mode Functionality
function toggleDarkMode() {
    document.body.classList.toggle('dark-mode');
    const btn = document.querySelector('.dark-btn');
    const icon = btn.querySelector('i');
    
    if (document.body.classList.contains('dark-mode')) {
        icon.classList.remove('fa-moon');
        icon.classList.add('fa-sun');
        localStorage.setItem('darkMode', 'enabled');
    } else {
        icon.classList.remove('fa-sun');
        icon.classList.add('fa-moon');
        localStorage.setItem('darkMode', 'disabled');
    }
}

// Load dark mode preference
function loadDarkModePreference() {
    const preference = localStorage.getItem('darkMode');
    if (preference === 'enabled') {
        document.body.classList.add('dark-mode');
        const btn = document.querySelector('.dark-btn');
        const icon = btn.querySelector('i');
        icon.classList.remove('fa-moon');
        icon.classList.add('fa-sun');
    }
}

// Temperature Conversion
function toggleTemperature() {
    isCelsius = !isCelsius;
    const tempDisplay = document.querySelector('.display-2');
    const tempButtons = document.querySelectorAll('.temp-btn');
    
    if (isCelsius) {
        tempDisplay.textContent = `${currentTempC}°C`;
        tempButtons[0].classList.add('active');
        tempButtons[1].classList.remove('active');
    } else {
        tempDisplay.textContent = `${currentTempF}°F`;
        tempButtons[1].classList.add('active');
        tempButtons[0].classList.remove('active');
    }
}

// Fetch Weather Data from API
async function fetchWeather(city) {
    try {
        const response = await fetch(
            `${API_URL}weather?q=${city}&appid=${API_KEY}&units=metric`
        );
        
        if (!response.ok) {
            throw new Error('City not found');
        }
        
        const data = await response.json();
        updateWeatherUI(data);
        currentCity = city;
        
    } catch (error) {
        console.error('Error fetching weather:', error);
        alert('City not found. Please try again.');
    }
}

// Update Weather UI with API Data
function updateWeatherUI(data) {
    currentTempC = Math.round(data.main.temp);
    currentTempF = (currentTempC * 9/5) + 32;
    
    document.querySelector('.weather-card h2').textContent = `${data.name}, ${data.sys.country}`;
    document.querySelector('.display-2').textContent = `${currentTempC}°C`;
    document.querySelector('h4').textContent = data.weather[0].main;
    
    // Update icons
    const weatherIcon = document.querySelector('.weather-icon');
    weatherIcon.className = `fas ${getWeatherIcon(data.weather[0].main)}`;
    
    // Update conditions
    document.querySelectorAll('.condition-card p')[0].textContent = `${data.main.humidity}%`;
    document.querySelectorAll('.condition-card p')[1].textContent = `${Math.round(data.wind.speed)} km/h`;
    document.querySelectorAll('.condition-card p')[2].textContent = `${data.visibility / 1000} km`;
    document.querySelectorAll('.condition-card p')[3].textContent = `${data.main.pressure} hPa`;
}

// Get Weather Icon Based on Condition
function getWeatherIcon(condition) {
    const icons = {
        'Clear': 'fa-sun',
        'Clouds': 'fa-cloud',
        'Rain': 'fa-cloud-rain',
        'Drizzle': 'fa-cloud-showers-heavy',
        'Thunderstorm': 'fa-cloud-bolt',
        'Snow': 'fa-snowflake',
        'Mist': 'fa-smog',
        'Smoke': 'fa-smog',
        'Haze': 'fa-smog',
        'Dust': 'fa-smog',
        'Fog': 'fa-smog'
    };
    return icons[condition] || 'fa-cloud-sun';
}

// Search City Functionality
function searchCity() {
    const searchInput = document.querySelector('.search-box input');
    const city = searchInput.value.trim();
    
    if (city) {
        fetchWeather(city);
        searchInput.value = '';
    } else {
        alert('Please enter a city name');
    }
}

// 7-Day Forecast (Mock Data - Replace with API call)
const forecastData = [
    { day: 'Thu', icon: 'fa-cloud-sun', temp: 31, condition: 'Partly Cloudy' },
    { day: 'Fri', icon: 'fa-cloud', temp: 29, condition: 'Cloudy' },
    { day: 'Sat', icon: 'fa-sun', temp: 37, condition: 'Sunny' },
    { day: 'Sun', icon: 'fa-cloud-rain', temp: 30, condition: 'Rain' },
    { day: 'Mon', icon: 'fa-cloud-bolt', temp: 28, condition: 'Thunderstorm' },
    { day: 'Tue', icon: 'fa-sun', temp: 34, condition: 'Sunny' },
    { day: 'Wed', icon: 'fa-cloud-sun', temp: 32, condition: 'Partly Cloudy' }
];

// Update Forecast UI
function updateForecast() {
    const forecastContainer = document.querySelector('.forecast-card .row');
    forecastContainer.innerHTML = '';
    
    forecastData.forEach(day => {
        const col = document.createElement('div');
        col.className = 'col-lg-2 col-md-4 col-6';
        col.innerHTML = `
            <div class="forecast-day text-center">
                <h5>${day.day}</h5>
                <i class="fas ${day.icon}"></i>
                <p>${day.temp}°</p>
                <small>${day.condition}</small>
            </div>
        `;
        forecastContainer.appendChild(col);
    });
}

// Event Listeners
document.addEventListener('DOMContentLoaded', () => {
    // Dark Mode
    document.querySelector('.dark-btn').addEventListener('click', toggleDarkMode);
    
    // Temperature Toggle
    document.querySelectorAll('.temp-btn').forEach((btn, index) => {
        btn.addEventListener('click', () => {
            if (index === 0) {
                isCelsius = true;
                toggleTemperature();
            } else {
                isCelsius = false;
                toggleTemperature();
            }
        });
    });
    
    // Search Button
    document.querySelector('.search-btn').addEventListener('click', searchCity);
    
    // Search on Enter Key
    document.querySelector('.search-box input').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
            searchCity();
        }
    });
    
    // Load saved preferences
    loadDarkModePreference();
    
    // Update forecast
    updateForecast();
    
    // Fetch initial weather (replace 'Hyderabad' with user's location)
    if (API_KEY !== 'YOUR_API_KEY_HERE') {
        fetchWeather('Hyderabad');
    }
});

// Get User's Location
function getUserLocation() {
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            (position) => {
                const { latitude, longitude } = position.coords;
                fetchWeatherByCoords(latitude, longitude);
            },
            (error) => {
                console.error('Location error:', error);
                fetchWeather('Hyderabad');
            }
        );
    } else {
        fetchWeather('Hyderabad');
    }
}

// Fetch Weather by Coordinates
async function fetchWeatherByCoords(lat, lon) {
    try {
        const response = await fetch(
            `${API_URL}weather?lat=${lat}&lon=${lon}&appid=${API_KEY}&units=metric`
        );
        const data = await response.json();
        updateWeatherUI(data);
        currentCity = data.name;
    } catch (error) {
        console.error('Error fetching weather by coords:', error);
        fetchWeather('Hyderabad');
    }
}

// Auto-detect location on load
getUserLocation();

// Add smooth animations
function addAnimations() {
    const elements = document.querySelectorAll('.weather-card, .condition-card, .forecast-card');
    elements.forEach((el, index) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(20px)';
        el.style.transition = `opacity 0.5s ease, transform 0.5s ease ${index * 0.2}s`;
        
        setTimeout(() => {
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
        }, 100);
    });
}

// Run animations after page load
setTimeout(addAnimations, 500);

// Refresh weather every 30 minutes
setInterval(() => {
    if (API_KEY !== 'YOUR_API_KEY_HERE') {
        fetchWeather(currentCity);
    }
}, 30 * 60 * 1000);
