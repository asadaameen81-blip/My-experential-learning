<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Weather Dashboard</title>

<link rel="stylesheet" href="style7.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

</head>
<body>

<div class="container">

    <div class="top">
        <h2>Hyderabad, IN</h2>
        <p>Wednesday, 14:13</p>
        <i class="fas fa-sun"></i>
        <h1>36°C</h1>
        <p>Mostly Sunny</p>
    </div>

    <div class="section">
        <h3>Conditions</h3>
        <table>
            <tr>
                <td><i class="fas fa-droplet"></i></td>
                <td>Humidity</td>
                <td>45%</td>
            </tr>
            <tr>
                <td><i class="fas fa-wind"></i></td>
                <td>Wind Speed</td>
                <td>12 km/h</td>
            </tr>
            <tr>
                <td><i class="fas fa-compress-arrows-alt"></i></td>
                <td>Pressure</td>
                <td>1012 hPa</td>
            </tr>
            <tr>
                <td><i class="fas fa-eye"></i></td>
                <td>Visibility</td>
                <td>10 km</td>
            </tr>
        </table>
    </div>

    <div class="section">
        <h3>7-Day Forecast</h3>

        <div class="forecast">

            <div class="day">
                <p>Thu</p>
                <i class="fas fa-cloud-sun"></i>
                <p>31°</p>
            </div>

            <div class="day">
                <p>Fri</p>
                <i class="fas fa-cloud"></i>
                <p>29°</p>
            </div>

            <div class="day">
                <p>Sat</p>
                <i class="fas fa-sun"></i>
                <p>37°</p>
            </div>

            <div class="day">
                <p>Sun</p>
                <i class="fas fa-sun"></i>
                <p>33°</p>
            </div>

            <div class="day">
                <p>Mon</p>
                <i class="fas fa-sun"></i>
                <p>34°</p>
            </div>

            <div class="day">
                <p>Tue</p>
                <i class="fas fa-cloud-bolt"></i>
                <p>28°</p>
            </div>

        </div>
    </div>
</div>

</body>
</html>

CSS:- 
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 30px;
}

.container {
  width: 90%;
  max-width: 1000px;
  background: white;
  border-radius: 25px;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
  padding: 35px;
}

.top {
  text-align: center;
  padding: 30px;
  background: linear-gradient(135deg, #ff9a9e, #fad0c4);
  border-radius: 18px;
  color: #222;
}

.top i {
  font-size: 70px;
  color: orange;
  margin: 20px 0;
}

.top h2 {
  font-size: 28px;
  margin-bottom: 8px;
}

.top p {
  font-size: 18px;
}

.top h1 {
  font-size: 60px;
  font-weight: bold;
}

.top .condition {
  font-size: 22px;
  margin-top: 8px;
}

.section {
  margin-top: 30px;
}

.section h3 {
  margin-bottom: 18px;
  color: #333;
  font-size: 22px;
}

table {
  width: 100%;
  border-collapse: collapse;
}

table td {
  padding: 16px;
  border-bottom: 1px solid #ddd;
  text-align: center;
  font-size: 17px;
}

table i {
  color: #007bff;
  font-size: 22px;
}

.forecast {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 20px;
}

.day {
  background: #f1f5f9;
  padding: 20px;
  text-align: center;
  border-radius: 15px;
  transition: 0.3s;
}

.day:hover {
  transform: translateY(-6px);
  background: #dbeafe;
}

.day p {
  font-size: 18px;
  font-weight: bold;
}

.day i {
  font-size: 36px;
  margin: 12px 0;
  color: #ff9800;
}

.day .temp {
  font-size: 22px;
  font-weight: bold;
}

@media (max-width: 600px) {
  .top h1 {
    font-size: 45px;
  }

  .top i {
    font-size: 55px;
  }

  .container {
    padding: 25px;
  }

  .day {
    padding: 15px;
  }

  .day i {
    font-size: 30px;
  }
}
